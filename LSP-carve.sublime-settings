{
	// The path to the server binary used to start the language server.
	// Use `auto` for the package to manage (install/update) the server automatically.
	// NOTE: Change this instead of directly updating `command` - the `${server_path}` variable is dynamically resolved based on this setting.
	// WARNING: Override at your own risk - using a custom binary can cause compatibility issues with server settings.
	"server_path": "auto",

	// The server is installed by lsp_utils; ${node_bin} and ${server_path} are
	// filled in by NodeManager (see plugin.py), so no global Node is required.
	"command": ["${node_bin}", "${server_path}", "--stdio"],

	// Carve documents. `text.carve` is the scope of the Carve syntax shipped by
	// the sublime-carve package, which this plugin expects to be installed.
	"selector": "text.carve",

	"initializationOptions": {
		// Sublime Text has no workspace trust, so the server treats every window
		// as untrusted and leaves `{{ path }}` includes off. Set this to true, or
		// set "carve.includes.enabled" to "on" below, to resolve includes.
		"workspaceTrusted": false,
	},

	// Server settings, sent under the `carve` section. A key left out here comes
	// from the project's `.carverc.json`, then from the server default, so only
	// set what you want to override. Examples:
	//
	//   "carve.format.alignTables": true,
	//   "carve.severities": { "table-width-total": "error" },
	//   "carve.includes.enabled": "on",
	//   "carve.includes.includeRoot": "${folder}",
	//
	// The full list is in the settings schema and in the carve-lsp README.
	"settings": {},
}
